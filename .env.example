# ==============================================================================
# Enterprise Multi-Agent Orchestration Framework - Environment Configuration
# ==============================================================================

# Deployment Tier & Server Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
PORT=8000

# Security & Authentication (Track B)
# Note: In production (ENVIRONMENT=production), API_AUTH_ENABLED must be true.
API_AUTH_ENABLED=false
# JSON mapping of SHA-256 key hashes to principal roles: e.g. {"<sha256_hash>": {"subject_id": "admin_1", "roles": ["ADMIN"]}}
API_KEY_HASHES={}
# JWT_SECRET_KEY=your_jwt_signing_secret_here
# JWT_ALGORITHM=HS256
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Provider API Keys (Fill with your provider credentials)
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM Routing & Model Configuration
LLM_PROVIDER=gemini
FALLBACK_PROVIDER=groq
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_ENABLE_FALLBACK=true

# State Persistence & PostgreSQL Storage (Track A & Track F)
# Store types: 'memory', 'sqlite', 'postgres'
STATE_STORE_TYPE=sqlite
SQLITE_DATABASE_PATH=data/orchestrator.db

# PostgreSQL Configuration (Required when STATE_STORE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=10

# Vector Storage & Retrieval
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Scalable Execution Engine (Track D)
EXECUTION_BACKEND=local_async
EXECUTION_MAX_CONCURRENCY=10
EXECUTION_MAX_QUEUE_SIZE=100
EXECUTION_SHUTDOWN_TIMEOUT_SECONDS=30.0

# Observability & Production Exporters (Track E)
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_METRICS_REQUIRE_AUTH=false

# OpenTelemetry Distributed Tracing (Optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-orchestrator
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS={"Authorization": "Bearer token"}
OTEL_EXPORTER_TIMEOUT_SECONDS=5.0
